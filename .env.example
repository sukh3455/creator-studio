# ==============================================================================
# CREATOR STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Notice: All values are blank by default. The application runs 100% offline
# using deterministic templates, local IndexedDB persistence, and client MediaRecorder.
# ==============================================================================

# 1. AI Planning Provider (OpenRouter)
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# 2. Database & Metadata (Supabase PostgreSQL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Media Storage (Cloudflare R2 S3-Compatible Storage)
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_DOMAIN=

# 4. Cloud Rendering Engine — Primary Free Default: GitHub Actions
VITE_DEFAULT_RENDER_PROVIDER=github_actions
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
VITE_GITHUB_TOKEN=
VITE_GITHUB_WORKFLOW=render-video.yml

# 5. Containerized Cloud Rendering Worker — Future Alternative (Google Cloud Run)
VITE_CLOUD_RUN_WORKER_URL=
VITE_CLOUD_RUN_AUTH_TOKEN=

